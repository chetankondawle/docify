# Server
NODE_ENV=development
PORT=5000

# Database (YugabyteDB - PostgreSQL compatible)
# For local YugabyteDB via docker-compose:
DATABASE_URL=postgresql://yugabyte@127.0.0.1:5433/yugabyte
# Set to 'true' to drop and recreate tables on startup (use with caution)
DB_SYNC_FORCE=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Gemini AI API
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-2.5-flash-lite