# Server
NODE_ENV=development
PORT=5000

# Database (configure as needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docify
DB_USER=postgres
DB_PASSWORD=password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# HackDNA AI API (replaces direct Gemini access)
HACKDNA_API_KEY=your_hackdna_api_key_here
HACKDNA_BASE_URL=https://hack.fyndna.com/api/v1
HACKDNA_MODEL=google/gemini-2.5-flash-lite
HACKDNA_SOURCE_EMAIL=your.team@email.com