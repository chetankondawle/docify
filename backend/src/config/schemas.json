      ],
      "deductions": [
        {
          "component": "string (e.g., PF, Professional Tax, TDS/Income Tax, ESI, Insurance, Loan Repayment, etc.)",
          "amount": "number"
        }
      ],
      "totalEarnings": "number",
      "totalDeductions": "number",
      "netSalary": "number"
    }
  }
