      "aadhaarNumber": "string",
      "address": "string"
    }
  },
  "PAN_CARD": {
    "documentType": "PAN_CARD",
    "schema": {
      "name": "string",
      "fatherName": "string",
      "dateOfBirth": "string (YYYY-MM-DD)",
      "panNumber": "string"
    }
  },
  "PASSPORT": {
    "documentType": "PASSPORT",
    "schema": {
