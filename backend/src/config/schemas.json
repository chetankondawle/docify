{
  "AADHAAR_CARD": {
    "documentType": "AADHAAR_CARD",
    "schema": {
      "name": "string",
      "gender": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "aadhaarNumber": "string (format: AADHAAR)",
      "address": "string"
    },
    "constraints": {
      "required": ["name", "aadhaarNumber", "dateOfBirth"],
      "formatValidations": {
        "aadhaarNumber": "AADHAAR",
        "dateOfBirth": "date"
      }
    }
  },
  "PAN_CARD": {
    "documentType": "PAN_CARD",
    "schema": {
      "name": "string",
      "fatherName": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "panNumber": "string (format: PAN)"
    },
    "constraints": {
      "required": ["name", "panNumber", "dateOfBirth"],
      "formatValidations": {
        "panNumber": "PAN",
        "dateOfBirth": "date"
      }
    }
  },
  "PASSPORT": {
    "documentType": "PASSPORT",
    "schema": {
      "name": "string",
      "gender": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "dateOfIssue": "date (YYYY-MM-DD)",
      "dateOfExpiry": "date (YYYY-MM-DD)",
      "passportNumber": "string (format: PASSPORT)"
    },
    "constraints": {
      "required": ["name", "passportNumber", "dateOfBirth"],
      "formatValidations": {
        "passportNumber": "PASSPORT",
        "dateOfBirth": "date",
        "dateOfIssue": "date",
        "dateOfExpiry": "date"
      }
    }
  },
  "SALARY_SLIP": {
    "documentType": "SALARY_SLIP",
    "schema": {
      "employeeName": "string",
      "employeeId": "string",
      "monthYear": "string",
      "basicSalary": "number",
      "allowances": "number",
      "deductions": "number",
      "netSalary": "number",
      "employeePanNumber": "string (format: PAN)"
    },
    "constraints": {
      "required": ["employeeName", "employeeId", "netSalary"],
      "formatValidations": {
        "employeePanNumber": "PAN"
      },
      "crossField": {
        "netSalary": "basicSalary + allowances - deductions"
      }
    }
  }
}
