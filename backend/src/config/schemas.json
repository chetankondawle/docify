{
  "AADHAAR_CARD": {
    "documentType": "AADHAAR_CARD",
    "schema": {
      "name": "string",
      "gender": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "aadhaarNumber": "string (format: AADHAAR)",
      "address": "string"
    },
    "constraints": {
      "required": ["name", "aadhaarNumber", "dateOfBirth"],
      "formatValidations": {
        "aadhaarNumber": "AADHAAR",
        "dateOfBirth": "date"
      }
    }
  },
  "PAN_CARD": {
    "documentType": "PAN_CARD",
    "schema": {
      "name": "string",
      "fatherName": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "panNumber": "string (format: PAN)"
    },
    "constraints": {
      "required": ["name", "panNumber", "dateOfBirth"],
      "formatValidations": {
        "panNumber": "PAN",
        "dateOfBirth": "date"
      }
    }
  },
  "PASSPORT": {
    "documentType": "PASSPORT",
    "schema": {
      "name": "string",
      "gender": "string",
      "dateOfBirth": "date (YYYY-MM-DD)",
      "dateOfIssue": "date (YYYY-MM-DD)",
      "dateOfExpiry": "date (YYYY-MM-DD)",
      "passportNumber": "string (format: PASSPORT)"
    },
    "constraints": {
      "required": ["name", "passportNumber", "dateOfBirth"],
      "formatValidations": {
        "passportNumber": "PASSPORT",
        "dateOfBirth": "date",
        "dateOfIssue": "date",
        "dateOfExpiry": "date"
      }
    }
  },
  "SALARY_SLIP": {
    "documentType": "SALARY_SLIP",
    "schema": {
      "employeeName": "string",
      "employeeId": "string",
      "monthYear": "string (e.g., Month YYYY)",
      "employeePanNumber": "string",
      "earnings": [
        {
          "component": "string (e.g., Basic Salary, HRA, Conveyance Allowance, Special Allowance, Medical Allowance, LTA, Bonus, etc.)",
          "amount": "number"
        }
      ],
      "deductions": [
        {
          "component": "string (e.g., PF, Professional Tax, TDS/Income Tax, ESI, Insurance, Loan Repayment, etc.)",
          "amount": "number"
        }
      ],
      "totalEarnings": "number",
      "totalDeductions": "number",      
      "basicSalary": "number",
      "allowances": "number",      
      "netSalary": "number"    
    },
    "constraints": {
      "required": ["employeeName", "employeeId", "netSalary"],
      "formatValidations": {
        "employeePanNumber": "PAN"
      },
      "crossField": {
        "netSalary": "basicSalary + allowances - deductions"
      }
    }
  }
}
